{
  "name": "@ledgerlens/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pdfjs-dist": "^6.5.438",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "postal-mime": "^4.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "pdf-lib": "^1.17.1",
    "supertest": "^7.3.2",
    "typescript": "^5.9.3"
  },
  "description": "LedgerLens REST API: Express 5 + SQLite",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc -p .",
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-exclude=\"src/index.ts\" --test-coverage-exclude=\"src/cli/**\" --test-coverage-lines=90 --test-coverage-branches=75 \"test/**/*.test.ts\"",
    "test:watch": "node --test --watch \"test/**/*.test.ts\"",
    "ingest": "node src/cli/ingest.ts",
    "fixtures": "node scripts/make-fixtures.ts",
    "seed:demo": "node scripts/seed-demo.ts",
    "demo": "node scripts/demo.ts"
  }
}
