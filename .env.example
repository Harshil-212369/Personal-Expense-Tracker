# Copy to .env (which is git-ignored) and fill in. Every value is optional:
# with nothing set, LedgerLens runs fully offline on 127.0.0.1.

# --- Server -----------------------------------------------------------------
PORT=4000
# Keep this on loopback unless you also set API_TOKEN. The server refuses to
# start on a non-loopback host without a token.
HOST=127.0.0.1
# Where the SQLite database lives. The default (./data) is git-ignored.
DATABASE_PATH=./data/ledgerlens.db
# Bearer token required on every /api request when set. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_TOKEN=
LOG_LEVEL=info

# --- Optional AI features ---------------------------------------------------
# Leave empty to disable every AI call. Deterministic parsers, rules and
# analytics keep working. When set, only redacted text and aggregate numbers
# are sent (see docs/SECURITY.md, "What leaves the machine").
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Comma-separated strings to strip from any text before it is sent to the API,
# for example your name and street. Card numbers, emails, phone numbers and
# postal codes are always stripped.
REDACT_TERMS=
